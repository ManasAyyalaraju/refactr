{
  "manifest_version": 3,
  "name": "refactr",
  "version": "0.1.0",
  "description": "Automatically tailor your resume for the job posting you're viewing.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "refactr",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://joinhandshake.com/*",
        "https://*.joinhandshake.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://joinhandshake.com/*",
        "https://*.joinhandshake.com/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://www.refactrapp.com/*"
    ]
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://joinhandshake.com/*",
    "https://*.joinhandshake.com/*",
    "http://localhost:8000/*",
    "https://api.refactrapp.com/*"
  ]
}
